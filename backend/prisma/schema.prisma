generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id              String   @id @default(uuid())
  name            String
  phone           String?
  company         String?
  binIin          String?
  category        String?  // SHOES, CLOTHES, MEDICINE, WATER, TOBACCO, OTHER
  status          String   @default("LEAD") // LEAD, IN_NEGOTIATION, KP_SENT, PAYMENT_PENDING, IN_PROGRESS, WON, LOST
  stage           String   @default("NEW")  // NEW, WARM, HOT, CLOSED
  estimatedVolume Int?     // Например, 5000 кодов
  estimatedAmount Float?   // В тенге ₸
  
  // Сводка по клиенту
  aiSummary       String?  // Выжимка текущей ситуации
  aiSentiment     String?  // Статус готовности (например, READY_TO_PAY, POSITIVE)
  aiObjections    String?  // Зафиксированные возражения ("дорого", "нет времени")
  aiNextStep      String?  // Следующее целевое действие
  
  notes           String?
  lastContactAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversations   ConversationChunk[]
  deals           Deal[]
  aiSuggestions   AISuggestion[]
  commercialQuotes CommercialQuote[]

  @@index([phone])
  @@index([status])
  @@index([company])
}

model ConversationChunk {
  id            String    @id @default(uuid())
  fingerprint   String?   @unique
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  channel       String    @default("WHATSAPP") // WHATSAPP, TELEGRAM, CALL, IN_PERSON
  rawText       String?   // Исходный текст или распознанный OCR
  screenshotUrl String?   // Путь к файлу скриншота (или список скриншотов через запятую)
  summary       String?   // Суть фрагмента диалога
  extractedInfo String?   // JSON строка с распознанными сущностями
  source        String    @default("WEB_PANEL") // TELEGRAM_BOT, WEB_PANEL, IMPORT
  createdAt     DateTime  @default(now())

  messages      Message[]

  @@index([clientId])
  @@index([createdAt])
}

model Message {
  id          String            @id @default(uuid())
  chunkId     String
  chunk       ConversationChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  sender      String            // CLIENT, MANAGER, SYSTEM
  senderName  String?
  content     String
  timestamp   DateTime?
  position    Int               @default(0)
  originalTime String?
  createdAt   DateTime          @default(now())

  @@index([chunkId])
  @@index([chunkId, position])
}

model ScreenshotDraft {
  id             String   @id @default(uuid())
  telegramUserId String
  targetClientId String?
  imageUrls      String[]
  parsed         Json
  reviewToken    String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([telegramUserId])
  @@index([expiresAt])
}

model FileDeletion {
  filename      String   @id
  clientId      String?
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  errorCode     String?
  createdAt     DateTime @default(now())

  @@index([nextAttemptAt])
  @@index([clientId])
}

model AISuggestion {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  provider      String   // GEMINI, OPENAI
  model         String?
  promptType    String   // REPLY_SUGGESTION, OBJECTION_HANDLING, COMMERCIAL_OFFER, SUMMARY
  query         String?  // Запрос менеджера
  suggestedText String   // Готовый ответ для WhatsApp
  explanation   String?  // Логика ответа
  wasCopied     Boolean  @default(false)
  knowledgeEvidence Json?
  commercialEvidence Json?
  createdAt     DateTime @default(now())

  @@index([clientId])
}

model Deal {
  id          String    @id @default(uuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  stage       String    @default("NEW") // NEW, QUALIFIED, OFFER_SENT, INVOICED, PAID, CLOSED_LOST
  amount      Float?
  services    String?   // JSON array
  codesCount  Int?
  deadline    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId])
  @@index([stage])
}

model KnowledgeItem {
  id        String   @id @default(uuid())
  category  String   // TARIFFS, IS_MPT_RULES, OBJECTIONS, STICKERING, FAQ
  title     String
  content   String
  isActive  Boolean  @default(true)
  reviewStatus String @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model KnowledgeImport {
  id          String   @id @default(uuid())
  bundleHash  String   @unique
  sourceRoot  String
  capturedAt  DateTime
  manifest    Json
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())
  sources     KnowledgeSource[]
  documents   KnowledgeDocument[]
}

model KnowledgeSource {
  id          String @id @default(uuid())
  importId    String
  import      KnowledgeImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  path        String
  sha256      String
  byteLength  Int
  data        Bytes

  @@unique([importId, path])
}

model KnowledgeDocument {
  id            String @id @default(uuid())
  importId      String
  import        KnowledgeImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  key           String
  kind          String
  language      String
  title         String
  categoryCodes String[]
  content       String
  payload       Json
  sha256        String
  sourcePaths   String[]
  reviewStatus  String @default("SOURCE")
  issues        String[]
  passages      KnowledgePassage[]

  @@unique([importId, key])
  @@index([importId, language, kind])
  @@index([categoryCodes], type: Gin)
}

model KnowledgePassage {
  id          String @id @default(uuid())
  documentId  String
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position    Int
  content     String

  @@unique([documentId, position])
}

model WebKnowledgeCategory {
  code    String @id
  title   String
  aliases String[]
}

model WebKnowledgeSource {
  id                String @id @default(uuid())
  url               String @unique
  title             String
  authority         String
  language          String @default("ru")
  categoryCodes     String[]
  topics            String[]
  discoveredFrom    String?
  depth             Int @default(0)
  priority          Int @default(50)
  intervalHours     Int @default(24)
  enabled           Boolean @default(true)
  status            String @default("PENDING")
  lastError         String?
  lastHttpStatus    Int?
  lastAttemptAt     DateTime?
  lastSuccessAt     DateTime?
  nextCheckAt       DateTime @default(now())
  lockedUntil       DateTime?
  currentRevisionId String?
  revisions         WebKnowledgeRevision[]

  @@index([enabled, nextCheckAt])
  @@index([categoryCodes], type: Gin)
}

model WebKnowledgeRevision {
  id           String @id @default(uuid())
  sourceId     String
  source       WebKnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sha256       String
  contentHash  String
  finalUrl     String
  contentType  String
  data         Bytes
  text         String
  title        String
  quality      String
  metadata     Json
  fetchedAt    DateTime @default(now())
  passages     WebKnowledgePassage[]
  evidence     WebKnowledgeEvidence[]

  @@unique([sourceId, sha256, contentHash])
}

model WebKnowledgePassage {
  id          String @id @default(uuid())
  revisionId  String
  revision    WebKnowledgeRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  position    Int
  content     String

  @@unique([revisionId, position])
}

model WebKnowledgeFact {
  id            String @id @default(uuid())
  key           String @unique
  title         String
  answer        String
  categoryCodes String[]
  topic         String
  keywords      String[]
  conditions    Json
  status        String @default("DRAFT")
  reviewedBy    String
  reviewedAt    DateTime
  validFrom     DateTime?
  validTo       DateTime?
  reviewDueAt   DateTime
  evidence      WebKnowledgeEvidence[]
}

model WebKnowledgeEvidence {
  id         String @id @default(uuid())
  factId     String
  fact       WebKnowledgeFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  revisionId String
  revision   WebKnowledgeRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  quote      String
  locator    String
  @@index([factId])
  @@index([revisionId])
}

model WebKnowledgeRun {
  id         String @id @default(uuid())
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  state      String @default("RUNNING")
  result     Json?
}

model CommercialQuote {
  id               String @id @default(uuid())
  clientId         String
  client           Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pricingHash      String
  pricingCheckedAt DateTime
  pricingSourceUrl String
  request          Json
  calculation      Json
  pricingSnapshot  Json
  total            Decimal @db.Decimal(16, 2)
  createdAt        DateTime @default(now())
  reviewAfter      DateTime
  revokedAt        DateTime?
  @@index([clientId, createdAt])
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AuthCode {
  id               String   @id @default(uuid())
  code             String
  telegramChatId   String
  telegramUsername String?
  expiresAt        DateTime
  isUsed           Boolean  @default(false)
  attempts         Int      @default(0)
  ip               String?
  createdAt        DateTime @default(now())

  @@index([code])
  @@index([telegramChatId])
}

model AdminUser {
  id               String   @id @default(uuid())
  telegramChatId   String   @unique
  telegramUsername String?
  role             String   @default("ADMIN")
  accessStatus     String   @default("PENDING")
  requestedAt      DateTime?
  approvedAt       DateTime?
  approvedById     String?
  lastLoginAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  sessions         AuthSession[]
  accessEvents     AccessEvent[]

  @@index([telegramChatId])
}

model AccessEvent {
  id          String    @id @default(uuid())
  userId      String
  user        AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorId     String?
  action      String
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}
