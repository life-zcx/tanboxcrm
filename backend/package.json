{
  "name": "tanbox-crm-backend",
  "version": "1.0.0",
  "description": "AI-powered CRM for Tanbox (WhatsApp + Telegram + Gemini + ChatGPT)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "seed": "tsx src/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/integration.test.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@prisma/client": "^5.22.0",
    "cheerio": "1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "1.13.0",
    "multer": "^2.5.0",
    "openai": "^7.54.0",
    "pdf-parse": "2.4.5",
    "sharp": "^0.35.5",
    "telegraf": "^4.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.5",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "node-fetch": {
      "whatwg-url": "^14.2.0"
    }
  }
}
